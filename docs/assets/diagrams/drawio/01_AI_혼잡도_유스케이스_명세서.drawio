        <mxCell id="v1" value="실시간 축제 데이터를 바탕으로 추천 부스, 회피 부스, 나중 추천 부스를 제안한다." style="whiteSpace=wrap;html=1;strokeColor=#93c5fd;strokeWidth=2;fillColor=#ffffff;fontSize=23;fontColor=#111827;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="360" y="195.0" width="1520" height="85.0" as="geometry"/></mxCell>
