        <mxCell id="v7" value="GPS 권한 거부 시 일반 축제 데이터 기반 추천 제공 / ML 예측 실패 시 규칙 기반 fallback 사용 / 데이터 부족 시 기본 안내 메시지 제공" style="whiteSpace=wrap;html=1;strokeColor=#93c5fd;strokeWidth=2;fillColor=#ffffff;fontSize=23;fontColor=#111827;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="360" y="705.0" width="1520" height="85.0" as="geometry"/></mxCell>
