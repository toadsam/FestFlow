        <mxCell id="v4" value="위치 정보 사용 가능 또는 일반 혼잡도 데이터 사용 가능, 부스/예약/체크인/공연 데이터 존재" style="whiteSpace=wrap;html=1;strokeColor=#93c5fd;strokeWidth=2;fillColor=#ffffff;fontSize=23;fontColor=#111827;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="360" y="450.0" width="1520" height="85.0" as="geometry"/></mxCell>
