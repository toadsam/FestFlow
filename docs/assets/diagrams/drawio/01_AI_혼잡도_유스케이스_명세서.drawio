        <mxCell id="v5" value="사용자가 지도 페이지 또는 분석 페이지에 접속한다." style="whiteSpace=wrap;html=1;strokeColor=#93c5fd;strokeWidth=2;fillColor=#ffffff;fontSize=23;fontColor=#111827;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="360" y="535.0" width="1520" height="85.0" as="geometry"/></mxCell>
        <mxCell id="k6" value="기본 흐름" style="whiteSpace=wrap;html=1;strokeColor=#93c5fd;strokeWidth=2;fillColor=#eff6ff;fontSize=24;fontColor=#111827;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="620.0" width="320" height="85.0" as="geometry"/></mxCell>
        <mxCell id="v6" value="① 지도/분석 페이지 접속 → ② GPS·예약·체크인·공연 데이터 수집 → ③ 혼잡도 특징값 생성 → ④ Python ML 예측 수행 → ⑤ 규칙 기반 점수와 결합 → ⑥ 추천/회피/나중 추천 부스 분류 → ⑦ 추천 이유 생성 → ⑧ 화면에 결과 표시" style="whiteSpace=wrap;html=1;strokeColor=#93c5fd;strokeWidth=2;fillColor=#ffffff;fontSize=23;fontColor=#111827;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="360" y="620.0" width="1520" height="85.0" as="geometry"/></mxCell>
